# DNBFILL - fills Static slots 1..8 the way DNB.OTY plays them, from a folder of drum and bass samples.
# 1 kick, 2 snare, 3 ghost (a second snare or a rim), 4 hats, 5 ride, 6 break, 7 bass, 8 fx.
# Each slot gets a random file whose name matches; tracks 1..8 are pointed at slots 1..8, FX1 BASE at 0.

def dnb_fill
  menu "POOL" >> "DNB FILL"
  confirm "REPLACE SLOTS 1-8?"
  param src folder "AUDIO"
  ext wav aif aiff aifc
  dir src deep
  match "*kick*" "bd*" "*bassdrum*"
  if gt file.len 0: static.load 1 file.pick
  dir src deep
  match "*snare*" "sd*" "*snr*"
  if gt file.len 0: static.load 2 file.pick
  dir src deep
  match "*rim*" "*ghost*" "*clap*" "*snare*"
  if gt file.len 0: static.load 3 file.pick
  dir src deep
  match "*hat*" "*hh*" "*shaker*"
  if gt file.len 0: static.load 4 file.pick
  dir src deep
  match "*ride*" "*cymb*" "*crash*"
  if gt file.len 0: static.load 5 file.pick
  dir src deep
  match "*break*" "*loop*" "*amen*"
  if gt file.len 0: static.load 6 file.pick
  dir src deep
  match "*bass*" "*reese*" "*sub*"
  if gt file.len 0: static.load 7 file.pick
  dir src deep
  match "*fx*" "*riser*" "*noise*" "*impact*"
  if gt file.len 0: static.load 8 file.pick
  l 1 8:
    trk i:
      if eq trk.type 0:              # Static tracks only: a Flex slot is another list
        trk.slot i
        par.set fx1 1 0
